# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# IMPORTANT: Exclude Raw Medical Datasets from Git
dataset/
data/
*.nii
*.nii.gz

# Model Weights & Training Checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
checkpoints/

# Environment Variables & Secrets
.env
.env.local
*.secret

# IDE & OS Specific Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Heavy Generated Artifacts (preserve report & sample overview in git)
results/full/*.pt
results/full/*.pth
results/10_patients/*.pt
results/10_patients/*.pth

# Generated experiment outputs (kept in the results/Drive workflow, not Git):
# qualitative visualization figures + their summary, and evaluation CSV/JSON.
results/**/visualizations/
*.png
!results/020_patient_overview.png
results/**/eval_*_per_case_metrics.csv
results/**/eval_*_summary.csv
results/**/eval_*_summary.json

# AMP pilot run artifacts (generated at runtime on Drive/Colab, not committed).
# The results/pilot_amp*/<arm>/ directories themselves are kept via .gitkeep.
results/pilot_amp*/**/pilot_history.json
results/pilot_amp*/**/runtime_info.json
results/pilot_amp*/**/config_snapshot.yaml

# RQ2 (Experiment 4) 3D-reconstruction outputs -- generated on Colab/Drive at
# runtime by scripts/run_rq2_reconstruction.py. The directory skeleton (.gitkeep)
# and the seeded report.md are kept in Git; heavy/generated artifacts are not.
# (*.nii.gz and *.png are already covered by the global rules above.)
results/exp04_rq2_reconstruction/reconstructions_3d/*.nii.gz
results/exp04_rq2_reconstruction/predictions_2d/*.npz
results/exp04_rq2_reconstruction/metadata/*.json
results/exp04_rq2_reconstruction/metrics_per_case.csv
results/exp04_rq2_reconstruction/metrics_summary.csv
results/exp04_rq2_reconstruction/reconstruction_validation.csv
results/exp04_rq2_reconstruction/summary.json